# Maintainer: mesutozansoftware <297260076+mesutozansoftware@users.noreply.github.com>
pkgname=chestzip-bin
pkgver=1.0.0
pkgrel=1
pkgdesc="Open-source archive manager with zip bomb protection (CHZ, ZIP, 7Z, TAR, RAR)"
arch=('x86_64')
url="https://github.com/mesutozansoftware/chestzip"
license=('MIT')
depends=('libglvnd' 'fontconfig' 'freetype2' 'dbus' 'libxkbcommon' 'libxkbcommon-x11'
         'xcb-util-cursor' 'xcb-util-wm' 'xcb-util-keysyms' 'xcb-util-renderutil'
         'xcb-util-image' 'hicolor-icon-theme' 'shared-mime-info' 'desktop-file-utils')
provides=('chestzip')
conflicts=('chestzip')
options=('!strip' '!debug')
source=("https://github.com/mesutozansoftware/chestzip/releases/download/v${pkgver}/ChestZip-${pkgver}-linux-x64.tar.gz")
sha256sums=('SKIP_REPLACED_BY_RELEASE_SCRIPT')

package() {
  install -d "$pkgdir/opt/chestzip" "$pkgdir/usr/bin"
  cp -a ChestZip/. "$pkgdir/opt/chestzip/"
  rm -f "$pkgdir/opt/chestzip/linux-install.sh"
  ln -s /opt/chestzip/chestzip "$pkgdir/usr/bin/chestzip"
  sed 's|^Exec=.*|Exec=/opt/chestzip/chestzip %F|' ChestZip/chestzip.desktop |
    install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/chestzip.desktop"
  install -Dm644 ChestZip/chestzip-mime.xml "$pkgdir/usr/share/mime/packages/chestzip.xml"
  install -Dm644 ChestZip/chestzip.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/chestzip.png"
  install -Dm644 ChestZip/chz-document.png \
    "$pkgdir/usr/share/icons/hicolor/512x512/mimetypes/application-x-chestzip.png"
  install -Dm644 ChestZip/_internal/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 ChestZip/_internal/THIRD_PARTY_NOTICES.md \
    "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_NOTICES.md"
}
